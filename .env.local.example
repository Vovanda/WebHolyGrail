# Настройки стенда. Скопируй в .env.local (он не попадает в репозиторий)
# и заполни - этого достаточно, чтобы поднять сайт на чистой машине.
#
# Хранилище секретов (Infisical) для стенда не обязательно: оно нужно там,
# где настройки общие на команду и меняются без выкладки. На боевом сайте
# секреты идут только через него.

# Payload
PAYLOAD_SECRET=                              # openssl rand -hex 32
DATABASE_URI=file:./data/site.db
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3001
PAYLOAD_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Client
NEXT_PUBLIC_CMS_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Site identity
SITE_NAME="Holy Grail (local)"

# Dev ports (override если 3000/3001 заняты другим WHG-инстансом на одной машине)
CMS_PORT=3001
CLIENT_PORT=3000

# Хранилище файлов.
#
# По умолчанию его нет: CMS складывает залитое рядом с собой и сама раздаёт.
# Так стенд поднимается без докера, а заливка и показ работают сразу.
#
# Внешнее хранилище включается тем, что эти строки раскомментированы. Значения
# ниже - для локального MinIO: он поднимется сам при запуске стенда, если есть
# докер. На боевом сайте здесь адреса своего провайдера, а значения приходят
# из хранилища секретов.
#
# S3_BUCKET=local-media
# S3_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_URL=http://localhost:9000/local-media
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin

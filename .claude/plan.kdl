        step 3.8.40 "Разметить части у всех компонентов шаблона" done=true {
            note "Владелец: «как закончишь, размечай все компоненты, которые есть в whg,
                  и все примитивы»."
            note "Правило: новый компонент размечает свои части признаком data-part,
                  иначе стиль ляжет на блок целиком и добраться до внутренностей нечем."
            note "Размечено шестнадцать: плеер со списком и его карточка, шапка, призыв,
                  сетка возможностей, лента событий, цитата, поверка, список документов,
                  сравнение, «на чём собрано», прозрачность стека, вопросы, карусель."
            note "Доразмечено фоном: 52 файла - витрина, блог, видео, каталог специалистов.
                  Словарь пополнен составными именами от родителя: card-media, card-body,
                  item-title, group-title."
            note "Найдено по ходу: сборщик частей ломался, если перед data-part стоял
                  атрибут со стрелкой - onClick={() => ...}. Атрибуты под парсер
                  не переставляют, чинится сам парсер."
        }
        step 3.8.44 "Строение блока читается со страницы, а не из объявлений" done=true {
            note "Владелец, увидев пустой список: «где твоя обещанная кнопка или поле или таб,
                  чтоб посмотреть иерархию, я не понял?», «ты мне напиздел что ли?»."
            note "Признано: механизм показа сделан, а данных для него нет - части размечены
                  в вёрстке, но нигде не объявлены для админки. Половина выдана за целое."
            note "Его же довод, решающий дело: «причём тут объявление и разметка? механизм
                  должен был работать и без разметки, с тегами»."
            note "Владелец о виде: «нет понимания, что строки выделяются и при клике
                  копируются», «оберни в секцию с нумерацией строк, чтоб по стилистике
                  выглядело как окно с кодом»."
            note "Значит источник - сама отрисованная страница: админка запрашивает её,
                  разбирает и показывает дерево этого блока с тегами, классами и data-part
                  там, где они есть. Работает у любого блока, размечен он или нет."
        }
        step 3.8.47 "В админке нельзя выбрать запись из существующих" done=true {
            note "Владелец: «нажимаю выбрать из существующих и потом кликаю на строку медиа,
                  и срабатывает логика клика для открытия этой страницы, а не выбор!
                  и так по всей админке выбрать ничего нельзя получается»."
            note "Блокирующий: без выбора существующих записей админка нерабочая."
            note "Подтвердилось: своя ячейка стояла первой колонкой и подменяла обёртку-
                  ссылку, которую Payload рисует сам. Ссылку воссоздавали руками, и в окне
                  выбора она перехватывала нажатие."
            note "Владелец о первой попытке чинить признаком isInDrawer: «звучит как
                  костыль» - и был прав. Починено по первопричине: первой идёт обычная
                  колонка, превью и обложка встали второй, CellLink удалён вместе
                  с логикой, которая его чинила."
        }
        step 3.8.45 "Акцентное слово в заголовке задаётся подстрокой" done=true {
            note "Владелец про подсказку поля: «текст, кстати, тупой, оно не так работает.
                  а проще... надо написать подстроку, которая станет акцентной, и всё.
                  верно же я говорю?»."
            note "Сейчас в заголовок ставят маркер {accent}, а слово берут из второго поля -
                  заголовок пишется с дыркой и заполняется отдельно."
            note "Делаем: одно поле с подстрокой, которая есть в самом заголовке, она
                  и красится. Старые записи с маркером продолжают работать."
            note "Владелец уточнил: подстрока ищется без учёта регистра."
            note "Он же: «давай через запятую тогда разные подстроки или лучше через |».
                  Взята вертикальная черта: запятая встречается в самом тексте акцента."
            note "Регулярку не берём: точка, скобки и плюс в обычном тексте начнут значить
                  не то, а ошибку человек увидит только на странице. Подстрока покрывает
                  случай целиком."
            note "Нашлось по ходу: общая функция для этого уже была - ею пользуется
                  разрезанная шапка. Своя разбивка убрана, обе шапки на одном механизме."
            note "Проверено на живой странице: заголовок целиком, выделенная часть покрашена."
        }
        step 3.8.48 "Выложить на прод" done=true {
            note "Владелец: «хочу демо того, что сделали сегодня, провести девушке, давай
                  заканчивай. да деплоить надо бы. хайлайты ток поправить»."
            note "Заметки к 0.3.0 переписаны под сделанное: видео, панель, вид блока
                  из админки, схема блока, версия в подвале."
            note "Перед отправкой: типы обоих пакетов чистые, 159 тестов зелёные, история
                  из девяти коммитов. Три миграции, все expand-only - старый цвет
                  их не читает."
            note "Отправлено 11 коммитов (fb416f3). Сборка на GitHub упала - причину
                  посмотреть первым делом при возвращении."
            note "Причина найдена: проверка расхождения схемы. Поля вида блока свели
                  к одному appearance_css, а в миграциях остались прежние corner_scope,
                  gap_below, padding, radius, space - и так во всех таблицах блоков."
            note "Владелец: «и да почини деплой и сделай его»."
            note "Локальный стек не трогать вовсе - на нём идёт демо. Ни перезапуска,
                  ни занятых портов, ни правки запущенного."
            step 3.8.48.1 "Миграция под поле вида блока" done=true {
                note "Миграция была написана руками и оказалась без снапшота схемы рядом.
                      Проверка сравнивает код с последним .json - им оставался позавчерашний,
                      и appearance_css в нём отсутствовало. Снапшот снят тем же вызовом,
                      каким его делает payload migrate:create; проверка локально зелёная."
            }
            step 3.8.48.2 "Довести выкладку до зелёного" done=true depends="3.8.48.1" {
                note "После правки: проверка схемы локально, отправка вместе с висящим
                      коммитом, дождаться сборки и синего-зелёного переключения."
                note "Сборка прошла, выкладка упала: замок базы на ALTER TABLE DROP COLUMN.
                      Удаление колонки переписывает таблицу целиком и требует базу в одни
                      руки, а старый цвет в это время обслуживает сайт."
                note "Миграция приведена к нашему канону: только добавление. Прежние пять
                      колонок остаются в базе, схеме кода они не мешают - убрать их можно
                      отдельной правкой, когда старого цвета уже не будет."
                note "Выложено: прод на 2ee494b, зелёный цвет, главная, видео, вопросы
                      и проверка здоровья отвечают. Своего стиля на проде нет ни у одного
                      блока - правило там пока не появляется."
            }
        }
        step 3.8.50 "Отступы блоков уменьшить и вынести в настройки сайта" {
            note "Владелец: «я вижу, что у наших блоков огромный блядь паддинг у всех,
                  особенно на /video. Надо установить всем 1 rem или максимум 1.5
                  и вынести эти дефолты в настройки сайта, чтоб всем разом можно было
                  поменять, подобрать»."
            note "Разведка: свой отступ на корне держат 22 блока - от восьми до
                  восемнадцати шагов сетки вразнобой; на общий класс переведены пять.
                  Пока их не свести, менять разом нечего."
            step 3.8.50.1 "Шаг секции в настройках сайта" now=true {
                note "Два значения - для узкого экрана и для широкого; по умолчанию
                      один и полтора шрифта. Плюс миграция под поля."
            }
            step 3.8.50.2 "Общий класс читает настройку" depends="3.8.50.1" {
                note "Значения едут переменными на корень страницы, класс шага секции
                      берёт их и держит прежние числа запасными."
            }
            step 3.8.50.3 "Свести корневые отступы блоков к общему классу" depends="3.8.50.2" {
                note "Двадцать два блока: убрать своё py с корневой секции, поставить
                      общий класс. Мелкие отступы внутри блока не трогать."
            }
        }
        step 3.8.49 "Свой стиль не перебивает шаг секции" blocked="стенд владельца занят показом" {
            note "Владелец: «padding-top: 0.1rem; padding-bottom: 0.1rem; но после сохранения
                  на сайте ничего не поменялось... если что это сепаратор компонент»."
            note "Причина видна из его же выкладки: правило .block-space задаёт padding
                  напрямую, а стиль блока лежит на обёртке вокруг - перебить не может."
            note "Владелец повторно, на другом блоке: «padding-top: 0; padding-bottom: 0;
                  border-radius: 0; и 16px,0px,16px,0px поставил на блоке "Проба доступа
                  к коду" а толку нет. CSS не переопределяет как я хотел!»."
            note "Он же: «и разделителем та же фигня и подозреваю с другими компонентами»."
            note "Значит участок шире, чем выглядел: не один сепаратор, а любой блок,
                  и не только отступы - радиус тоже не проходит. Проверять на всех
                  примитивах, а не на том, с которого пожаловались."
            note "Заодно проверить поле отступов из админки: 16px,0px,16px,0px владелец
                  выставил, и оно тоже не применилось."
            note "Засада: причин три, а не одна. Первая - признак записи стоял на обёртке
                  вокруг блока, и правило не доставало до его собственного класса."
            note "Вторая - форма отступов пишет объявление без имени свойства: в базе
                  лежит «: 16px,0px,16px,0px». Такое объявление браузер отбрасывает."
            note "Третья - форма пишет «padding-top: 1rem!» с восклицательным знаком
                  без important. Тоже отбрасывается, и так на четырёх блоках страницы
                  видео: обложка, волна, текст, набор видео."
            step 3.8.49.1 "Правило доходит до самого блока" done=true {
                note "Признак на корень блока перенести нельзя: блок отрисовывается своим
                      компонентом, и атрибут ушёл бы ему в свойства, а не в разметку -
                      проверено, на странице не оказалось ни одного помеченного узла."
                note "Сделано иначе: обёртка одна на признак и на видимость, а правило
                      целится в её содержимое - [data-block=\"id\"] > *. Проверено на живой
                      странице: отступ у секции сменился с 56 на 16 точек."
                note "Стенд владельца на трёх тысячах перестал пересобираться - стек поднят
                      дважды, и два запуска дерутся за кеш сборки. Стенд не трогаю, идёт
                      демо; механику проверял правилом, вписанным в страницу на ходу."
            }
            step 3.8.49.2 "Форма не даёт записать нерабочее" {
                note "Разобрано: форма мусор не создаёт - и «1rem!», и «16px,0px,16px,0px»
                      вписаны рукой владельца. Второе он взял из поиска про скругление
                      только верхних углов, запятые оттуда."
                note "Помочь ей нечем: пример формата в коде объявлен и нигде не показан,
                      обещанный отдельный ввод для углов не сделан, а непонятое значение
                      помечено вопросительным знаком, которого не видно."
                note "Делаем: пример формата в подсказке поля значения, у скругления
                      пример валидный, непонятое значение видно рамкой и словами."
                note "Написано и типы чистые, но глазами не смотрено: браузер для проверок
                      общий с владельцем, а он в это время показывает сайт. Проверить
                      в обеих темах, на широком и узком, когда стенд освободится."
            }
            step 3.8.49.3 "Починить уже записанное у владельца" depends="3.8.49.2" {
                note "Шесть блоков на странице видео лежат с испорченными объявлениями -
                      переписать через API, иначе исправная форма их не вылечит."
            }
        }
        step 3.8.46 "У блока текста нет ни одной части" {
            note "Владелец: «на компоненте Текст не работает». Проверено: схема отдаёт ноль
                  частей - абзацы, заголовки и списки рисует общий отрисовщик, который при
                  разметке пропустили."
            note "Разметить в нём хотя бы роли: абзац, заголовок, список, цитата - иначе
                  у самого частого блока настраивать нечего."
        }
        step 3.8.43 "Страница плейлиста собирается из блоков" issue="#109" {
            note "Владелец: «добавь таб, который бы позволил перестроить вёрстку страницы
                  плейлиста... пусть из блоков состоит как обычная страница»."
            note "Сейчас страница плейлиста - жёсткая вёрстка: обложка, плеер, список.
                  Нужна вкладка со своей вёрсткой из тех же блоков, что и у страниц."
            note "Пусто - страница выглядит как сейчас: у существующих плейлистов ничего
                  не должно поехать."
        }
        step 3.8.16 "UI Kit внутри WHG" {
            note "Владелец: «ты же делаешь конструктор сайтов, шаблон с компонентами - будь
                  добр строго держаться философии и строить UI Kit внутри WHG»."
            note "Суть его словами: «мы наращиваем примитивы, в которых уверены, всё завязано
                  на палитрах, настройках и т.д. из админки, и потом ничего не плывёт,
                  не едет, нет сюрпризов - разработка просто кубики собирать же»."
            note "Собрать перечень того, что уже есть, и то, что раз за разом собирается
                  на месте: кнопки, поля ввода, карточки, окна, полосы, значки."
        }
        step 3.8.25 "Название видео не дублируется, описание под видео сворачивается" {
            note "Владелец: «название видео есть в плеере внизу и под видео» - дублируется."
            note "Его решение: «я предлагаю перенести его на оверлей видео вверх,
                  как на ютубе, и всё»."
            note "И дальше: «под видео должно быть описание в 2 строки и кнопкой раскрыть
                  и свернуть», «даже в плейлисте»."
            note "Засада: у видео в контрактах описания нет вовсе - есть только заголовок.
                  Значит нужны поле в CMS, миграция и передача через contracts."
        }
        step 3.8.37 "Учёт того, что накручено поверх Payload" {
            note "Владелец: «стоит и об этом в документации написать, что есть и визибилити
                  навешана», «и потом вести учёт чего дополнительного мы накрутили поверх
                  компонентов пайлоада»."
            note "Собрать перечень: помощники на реестре блоков, свои поля-компоненты,
                  короткие имена служебным типам."
        }
        step 3.8.20 "Страница с временной шкалой версий" {
            note "Владелец: «я просто ещё хочу потом страницу сделать, что нового,
                  с таймлайном» - но «это в issue можно завести, сейчас не берём,
                  только версионирование»."
        }
        step 3.8.17 "Вычистить оставшиеся хардкоды цвета и тени" state="осталась статусная палитра баннера достижений" {
            note "Владелец: «проверь все новые компоненты на хардкоды». Проверено гребёнкой -
                  находки не только в новых: AchievementBanner, BannerSlider, CarouselRows,
                  CertifiedNotice, HeroCinematic."
            note "Идёт после UI Kit: часть из них уйдёт сама, когда появится общий вид."
        }
        step 3.8.9 "Причесать историю перед выкладкой" done=true {
            note "Владелец: подозревает мусорные коммиты. Факт - из 63 неотправленных
                  27 это правки плана, по одному коммиту на отметку."
            note "Склеить правки плана с содержательными коммитами, к которым они относятся,
                  чтобы каждый коммит оставался самостоятельным."
            note "Делается перед отправкой, не по ходу работы."
            note "Владелец перед деплоем: «ты обещал склеить коммиты перед деплоем, если что,
                  и текста там обобщить, чтоб не было промежуточной истории у коммитов фичей»."
            note "Сделано: 124 коммита пересобраны в девять - по одному на фичу, промежуточных
                  шагов и отдельных правок плана не осталось. Дерево сверено с меткой,
                  поставленной до склейки: расхождений нет."
        }

    stage 4 "Сетка плиток без пустых слотов" state="идёт" issue="#88" {
        note "Владелец 27.08.2026: это общее правило для всех плиток в системе, а не правка
              одного блока. Сетка всегда образует прямоугольник, без одиноких карточек
              в последнем ряду."
        note "Ряды подбираются так, чтобы фигура была уравновешенной: восемь - это 3 2 3 или
              3 4, но не 3 3 2; девять - 3 3 3; шесть - 3 3."
        note "Пустых слотов не должно оставаться ни при какой ширине: сколько бы плиток
              ни влезало в ряд - две, три, четыре, - последний ряд не бывает дырявым. Значит
              раскладка пересчитывается под ширину, а не задаётся раз и навсегда."
        note "Валидные раскладки со слов владельца: 2 2, 2 3, 3 3, а на совсем узком экране
              2 2 2. То есть ряды бывают разной длины, и это нормально - лишь бы ни один
              не оказался дырявым, а фигура читалась уравновешенной."
        note "Задача #88, закрывает и #89."

        step 4.1 "Разбиение на ряды: чистая функция от числа плиток и вместимости ряда" done=true {
            note "Подбор даёт палиндром - 3 2 3, 4 5 4, 2 2 2 на узком экране. Остаток
                  раздаётся симметрично: нечётный в середину, чётный парами к краям.
                  Девять проверок."
        }
        step 4.1.1 "Своя раскладка полем блока" done=true {
            note "Нотация выбрана вместе с владельцем: имена областей, ряды через двоеточие -
                  «a b : a c». Повторяет grid-template-areas, только без кавычек: в поле
                  админки так короче и ничего не экранируется."
            note "Имя означает номер плитки: «a» первая, «b» вторая. Им же задаётся порядок -
                  «a b c e : a b d d» уводит четвёртую вниз, а пятую поднимает наверх, хотя
                  в блоке порядок не менялся."
            note "Повтор пишется числом: «3a» это «a a a». Точка - пустое место, как в CSS."
            note "Отвергнуты: ширины «2 1 : 1 1 1 1» - ими не описать вертикальное объединение,
                  а оно владельцу важно; размеры «2x1 1x2» - тем же и порядок ими не задать."
            note "Запись, которая не складывается в сетку - ряды разной длины или имя вразброс
                  вроде «a b : b a», - отбрасывается целиком, и об этом говорится в админке."
            note "Раскладка описывает начало: плиток больше - остаток досчитывается общим
                  правилом, чтобы строку не правили при каждой новой плитке."
            note "Разбор лежит в contracts: им пользуется и сайт, и админка. Тринадцать
                  проверок, включая пример владельца «a b c e : a b d d»."
        }
        step 4.1.2 "Общее поле раскладки для всех плиточных блоков" state="следующий" {
            note "Владелец: если блок предполагает плиточную раскладку, поле её задания
                  появляется у него само - не копировать в каждый блок руками."
            note "Значит общий кусок полей для Payload и общий интерфейс в contracts, а не
                  отдельное поле в каждом блоке."
            note "Разбор чистит ввод: лишние пробелы по краям и подряд идущие схлопываются -
                  человек пишет как удобно, а не как требует разбор."
        }
        step 4.2 "Примитив сетки, который считает раскладку сам"
        step 4.3 "Правило записано в R-правила и skill, чтобы новые сетки его наследовали"
        step 4.3.1 "Раздел в документации под лейаутом: как задавать раскладку" {
            note "Владелец: после того как механизм заработает в интерфейсе, дописать его
                  в документацию рядом с разделом про раскладку - там, где человек уже читает
                  про панели и слоты."
            note "Показать саму нотацию на примерах, порядок карточек буквами, повтор числом,
                  что бывает с записью, которая не складывается."
        }
        step 4.4 "Плитки стека, витрина сайтов и прочие сетки переведены на примитив"
        step 4.5 "Проверить на разных ширинах: дырявого ряда нет нигде"
    }

    stage 5 "Карусели на главной" state="ждёт" issue="#97" {
        note "Владелец: перевести на новую реализацию, без слипания карточек. Он это уже
              ловил - «мафия и дружина слиплись»."

        step 5.1 "Проверить, что на главной стоит и на чём собрано"
        step 5.2 "Перевести оставшееся на примитив карусели"
        step 5.3 "Отступ у первой и последней карточки равен зазору между ними"
    }

    stage 6 "Два плейлиста на одной странице" state="ждёт" issue="#98" {
        note "Выбор видео живёт в адресе одним значением на страницу: переключил в одном
              плейлисте - соседний своего кода не находит и сбрасывается на первое видео."
        note "Значение подписывается плейлистом: v=<плейлист>:<видео>, параметр повторяется.
              Без подписи - прежний вид, чтобы разосланные ссылки работали. Начато и отложено."

        step 6.1 "Подписанный выбор: чтение и запись"
        step 6.2 "Плеер и список берут своё значение"
        step 6.3 "Проверить на странице с двумя плейлистами"
    }

    stage 7 "Вход как второй путь к доступу" state="ждёт" issue="#99" {
        note "Право вошедшего уже ищется в базе, повторное погашение кода продлевает его.
              Осталось лицо: при отказе «нужен вход» зритель видит только ввод кода."

        step 7.1 "В заглушке отказа предлагается войти"
        step 7.2 "Проверить: вошёл на другом устройстве - доступ нашёлся сам"
    }

    stage 8 "Хвосты по сделанному" state="ждёт" {
        step 8.1 "Продолжение просмотра проверить на длинном видео" {
            note "Место не запоминается в последние двадцать секунд, а все демо-видео короче.
                  Правка общая с таймкодом, живого подтверждения нет."
        }
        step 8.2 "Убрать из хранилища прежние снимки сайтов" {
            note "При замене файлов Payload завёл новые имена, старые остались лежать."
        }
        step 8.3 "Проверить панель и переключатель на живом сайте после последней выкладки"
        step 8.4 "Внешний узел настроек как источник переключателей" {
            note "Сейчас источник один - таблица в базе, плюс перекрытие переменной окружения.
                  Внешний узел появится, когда сайтов станет несколько: меняется только
                  прослойка чтения."
        }
        step 8.13 "Окно ввода кода закрывается рывком через сворачивание" done=true {
            note "Владелец: при закрытии окно схлопывается по высоте - кнопка исчезает,
                  поле сжимается вниз по центру, крестик дёргается."
            note "Закрывать без изменения размеров: содержимое остаётся на месте, окно
                  либо убирается сразу целиком, либо быстро растворяется."
            note "Причина: переход шёл по всем свойствам разом и вдобавок ужимал окно.
                  Теперь меняется только прозрачность, уход короче прихода."
            note "Проверено замером: размеры окна при закрытии те же - 560 на 50."
        }
        step 8.12 "Полноэкранный режим раскрывается на монитор, а не на окно браузера" {
            note "Владелец: на ПК кнопка растягивает плеер на всё окно браузера, но это
                  не полный экран - он должен быть поверх всех окон, на весь монитор."
            note "Сперва прочитать доку плеера: возможно это его известное поведение
                  и решается настройкой, а не своим кодом."
        }
        step 8.11 "Меню настроек плеера: своя тема и место рядом с шестерёнкой" state="тема сделана, место внесено, глазами не проверено" {
            note "Владелец: на ПК меню настроек белое при тёмной теме - брендинга в нём
                  не чувствуется. Плеер сторонний, значит его меню перекрашивается нашими
                  переменными, а не остаётся как пришло."
            note "На телефоне то же самое, и вдобавок меню открывается внизу экрана, хотя
                  плеер вверху: оторвано от шестерёнки, которой его вызвали, - непривычно."
            note "Тема сделана штатным путём: у плеера свои переменные для меню, их и задаём -
                  правила его не трогаем, чтобы он оставался обновляемым. Цвета из палитры."
            note "Причина белого на белом: фон брался из светлой ветки плеера, а текст
                  из тёмной. Проверено в обеих темах глазами."
            note "Осталось: место меню на телефоне - оно должно открываться у шестерёнки,
                  а не внизу экрана."
            note "Найдено по ходу: слой плеера всегда идёт с признаком светлой темы, что бы
                  ни стояло на сайте. Меню мы перекрасили своими переменными, но остальной
                  плеер остаётся светлым - снять признак, когда сайт тёмный."
        }
        step 8.10 "Кнопка трансляции на телевизор прячется, когда её некуда нажимать" {
            note "Владелец: если трансляция недоступна и не работает - кнопку не показывать
                  вовсе, а не рисовать неработающей."
        }
        step 8.5 "Несколько звуковых дорожек у видео"
        step 8.8 "Убрать служебные заметки из подсказок в админке" {
            note "У поля «Тема» в подсказке висит внутренняя пометка про недоделку и ссылка
                  на папку с заметками разработчика - человеку в админке это не читается."
            note "Пройти подсказки глазами: они описывают поле одной фразой, без внутренних
                  ссылок и планов."
        }
        step 8.9 "Осиротевшие процессы держат местную базу" {
            note "После перезапуска отладочного сервера прежний остаётся жить и держит файл
                  базы - запись падает с «database is locked», а страница при этом
                  открывается. Ловится по времени правки в базе, не по виду страницы."
            note "Перед подъёмом сервера проверять, не остался ли прежний, и снимать всю
                  цепочку, а не только того, кто слушает порт."
        }
        step 8.7 "Испорченное название у видео authored.mp4 в местной базе" {
            note "В записи лежат байты в чужой кодировке - в списке видно кракозябры.
                  Порча данных, а не кода: запись создавалась скриптом из консоли."
            note "Чинится переписыванием названия через API. На витрине проверить отдельно -
                  туда те же скрипты не ходили."
        }
        step 8.6 "Удаление автора уносит его область целиком"
    }

    stage 9 "Витрина шаблона" state="ждёт" issue="#32" {
        step 9.1 "Показать на витрине блоки, статью с видео внутри и формы"
        step 9.2 "Почта администратора витрины переезжает на свой домен" state="в конце"
    }

    stage 10 "Секреты на проде" state="ждёт" issue="#100" {
        step 11.1 "Перезавернуть секреты, оставшиеся открытыми" blocked="ждём слова владельца" {
            note "Инструмент готов и проверен на копии базы. Прогон на рабочем сайте трогает
                  живые ключи, поэтому идёт с его ведома."
        }
    }

    stage 11 "Просмотры онлайн" blocked="ждём решения владельца" issue="#101" {
        note "Развилка: где держать живые просмотры. Отметка приходит от каждого зрителя раз
              в минуту, живёт минуты и тут же устаревает."
        note "Предложение: память приложения сейчас, отдельное быстрое хранилище - когда
              появится второй сайт с платными курсами. Разбор - в эпике #95."

        step 11.1 "Идентификатор просмотра и отметки «играю» с позицией"
        step 11.2 "Учёт живых просмотров с истечением по времени"
        step 11.3 "Лимит одновременных просмотров на учётную запись - настройка владельца"
        step 11.4 "Поведение при превышении: отказать новому или вытеснить самый старый"
        step 11.5 "Сколько смотрит прямо сейчас - в админке"
        step 11.6 "Уборка протухших просмотров"
        step 11.7 "Отдельный текст при превышении лимита"
        step 11.8 "Проверка: третий зритель на двух разрешённых получает понятный отказ"
    }

    stage 12 "Статистика и реакции" blocked="ждём решения владельца" issue="#102" {
        note "Считается из тех же отметок, что и живые просмотры, поэтому решается вместе
              с этапом 9."

        step 12.1 "Счётчики: всего просмотров, уникальных, средняя глубина"
        step 12.2 "Досмотры: четверть, половина, три четверти, до конца"
        step 12.3 "Кривая удержания: на какой секунде бросают"
        step 12.4 "Лайки: один на зрителя, снимается повторным нажатием"
        step 12.5 "Защита от накрутки: лайк привязан к зрителю, а не к нажатию"
        step 12.6 "Просмотры и лайки рядом с плеером и на странице видео"
        step 12.7 "Сводка в админке: карточка видео и список по популярности"
        step 12.8 "Блок «Популярное»"
        step 12.9 "Статистика по плейлисту целиком"
        step 12.10 "Автор видит статистику только по своим плейлистам"
        step 12.11 "Проверка: счётчики и лайки не накручиваются перезагрузкой"
    }

    stage 13 "Доставка кодов" blocked="ждём решения владельца" issue="#103" {
        note "Оба пункта упираются в одно: чем доставлять код человеку, у которого его нет
              под рукой. Предложение: почта сейчас, сообщения на телефон - когда пойдут
              продажи. Почтовый отправитель шаблону нужен и без этого."

        step 13.1 "Подтверждение устройства без учётной записи"
        step 13.2 "Повторная выдача кода: почтой или сообщением"
    }
}

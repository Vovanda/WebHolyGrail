// Работы по Web Holy Grail. План переписан 27.08.2026 с текущего прогресса: прежний
// разросся до тысячи строк и стал нечитаемым. Всё незакрытое перенесено сюда,
// история решений осталась в plan.kdl.old.

plan "Работы по WHG" {

    note "Порядок: сначала то, на что владелец указал и что видно на сайте; потом внутреннее;
          потом то, что упирается в его решение."

    stage 1 "Что уже работает" state="закрыт" issue="#95" {
        note "Сводка, чтобы не искать в истории. Подробности - в задачах #94, #36 и эпике #95."

        step 1.1 "Нарезка в несколько качеств, шифрование, удаление исходника" done=true
        step 1.2 "Доступ: открытое всем, закрытое по праву на плейлист" done=true
        step 1.3 "Коды доступа: выдача, ввод, снятие замков без перезагрузки" done=true
        step 1.4 "Плеер: субтитры, оглавление, кадры на полосе, мини-плеер, метка зрителя" done=true
        step 1.5 "Плейлист: колонкой, лентой или панелью за кнопкой над плеером" done=true
        step 1.6 "Выбранное видео и таймкод живут в адресе" done=true
        step 1.7 "Защита от выкачивания: счёт ключей и кусков, проверка источника" done=true
        step 1.8 "Переключатели возможностей, выбор слоя плеера на признаке" done=true
        step 1.9 "Витрина: снимки сайтов в двух темах" done=true
    }

    stage 2 "Регресс админки: списками нельзя пользоваться" state="идёт" issue="#104" {
        note "Владелец 27.08.2026: пользоваться невозможно, это регресс системы, а не отделка.
              Поэтому идёт первее всего."
        note "Списки медиа и плейлистов: строка не открывается, превью пустое, хотя кадр
              известен, а в колонке имени файла висит лишнее лого."

        step 2.1 "Строка списка открывает запись" now=true
        step 2.2 "Превью показывается там, где кадр известен"
        step 2.3 "Лишнее лого убрано из колонки имени файла"
        step 2.4 "То же проверено на плейлистах"
        step 2.5 "Раздел доступа к видео переехал под группу «Медиа»" issue="#105" {
            note "Владелец: доступ к видео должен лежать под медиа, а не отдельной группой -
                  человек ищет его там, где лежит само видео."
        }
    }

    stage 3 "Плейлист виден там, где его ищут" state="идёт" issue="#96" {
        note "Владелец указал 27.08.2026 на три места подряд: в каждом либо пусто, либо строка
              текста там, где ждёшь карточку."

        step 3.1 "Панель на широком экране: колонка сбоку, страница не двигается" state="написано, глазами не проверено" {
            note "Владелец 27.08.2026: на ПК сдвиг сводится к появлению колонки слева или
                  справа, контент не едет вовсе."
            note "И появляется она из-под страницы, а не влетает от края экрана: панель лежит
                  ниже слоя контента и проступает из-под него."
            note "Сдвиг остаётся узкому экрану: там колонке взяться неоткуда."
        }
        step 3.2 "Панель: скругление, липкость, подтягивание вверх" state="написано, глазами не проверено" {
            note "Скруглённый угол читается как обрезанный кусок - убран. Родовая шапка липнуть
                  не должна, липкие имя плейлиста и список - сделано, глазами не проверено."
            note "Осталось: если внизу не помещается три карточки, панель поднимается выше.
                  Расчёт написан, но на живом сайте низ уходит за экран."
        }
        step 3.3 "Кнопка плейлиста продублирована в шапке панели меню" {
            note "Прямая просьба: та же кнопка, что стоит над плеером, справа от лого
                  с названием в шапке панели меню."
            note "Панель меню открывается на любой странице, поэтому кнопка появляется только
                  когда на странице есть плейлист в режиме панели."
        }
        step 3.4 "Обложка плейлиста стопкой кадров" done=true {
            note "Канал отдаёт до трёх кадров видео, клиент кладёт их стопкой со сдвигом.
                  Своя обложка, если задана, показывается как есть."
        }
        step 3.5 "На канале плейлист показывается карточкой с обложкой" depends="2.4" {
            note "Код выложен, осталось посмотреть глазами на живом сайте."
        }
        step 3.6 "На странице видео плейлисты показываются карточками, а не строкой" {
            note "Сейчас там строка «входит в плейлисты»."
        }
    }

    stage 4 "Сетка плиток без пустых слотов" state="идёт" issue="#88" {
        note "Владелец 27.08.2026: это общее правило для всех плиток в системе, а не правка
              одного блока. Сетка всегда образует прямоугольник, без одиноких карточек
              в последнем ряду."
        note "Ряды подбираются так, чтобы фигура была уравновешенной: восемь - это 3 2 3 или
              3 4, но не 3 3 2; девять - 3 3 3; шесть - 3 3."
        note "Пустых слотов не должно оставаться ни при какой ширине: сколько бы плиток
              ни влезало в ряд - две, три, четыре, - последний ряд не бывает дырявым. Значит
              раскладка пересчитывается под ширину, а не задаётся раз и навсегда."
        note "Валидные раскладки со слов владельца: 2 2, 2 3, 3 3, а на совсем узком экране
              2 2 2. То есть ряды бывают разной длины, и это нормально - лишь бы ни один
              не оказался дырявым, а фигура читалась уравновешенной."
        note "Задача #88, закрывает и #89."

        step 4.1 "Разбиение на ряды: чистая функция от числа плиток и вместимости ряда" done=true {
            note "Подбор даёт палиндром - 3 2 3, 4 5 4, 2 2 2 на узком экране. Остаток
                  раздаётся симметрично: нечётный в середину, чётный парами к краям.
                  Девять проверок."
        }
        step 4.1.1 "Своя раскладка полем блока" done=true {
            note "Нотация выбрана вместе с владельцем: имена областей, ряды через двоеточие -
                  «a b : a c». Повторяет grid-template-areas, только без кавычек: в поле
                  админки так короче и ничего не экранируется."
            note "Имя означает номер плитки: «a» первая, «b» вторая. Им же задаётся порядок -
                  «a b c e : a b d d» уводит четвёртую вниз, а пятую поднимает наверх, хотя
                  в блоке порядок не менялся."
            note "Повтор пишется числом: «3a» это «a a a». Точка - пустое место, как в CSS."
            note "Отвергнуты: ширины «2 1 : 1 1 1 1» - ими не описать вертикальное объединение,
                  а оно владельцу важно; размеры «2x1 1x2» - тем же и порядок ими не задать."
            note "Запись, которая не складывается в сетку - ряды разной длины или имя вразброс
                  вроде «a b : b a», - отбрасывается целиком, и об этом говорится в админке."
            note "Раскладка описывает начало: плиток больше - остаток досчитывается общим
                  правилом, чтобы строку не правили при каждой новой плитке."
            note "Разбор лежит в contracts: им пользуется и сайт, и админка. Тринадцать
                  проверок, включая пример владельца «a b c e : a b d d»."
        }
        step 4.1.2 "Общее поле раскладки для всех плиточных блоков" now=true {
            note "Владелец: если блок предполагает плиточную раскладку, поле её задания
                  появляется у него само - не копировать в каждый блок руками."
            note "Значит общий кусок полей для Payload и общий интерфейс в contracts, а не
                  отдельное поле в каждом блоке."
            note "Разбор чистит ввод: лишние пробелы по краям и подряд идущие схлопываются -
                  человек пишет как удобно, а не как требует разбор."
        }
        step 4.2 "Примитив сетки, который считает раскладку сам"
        step 4.3 "Правило записано в R-правила и skill, чтобы новые сетки его наследовали"
        step 4.3.1 "Раздел в документации под лейаутом: как задавать раскладку" {
            note "Владелец: после того как механизм заработает в интерфейсе, дописать его
                  в документацию рядом с разделом про раскладку - там, где человек уже читает
                  про панели и слоты."
            note "Показать саму нотацию на примерах, порядок карточек буквами, повтор числом,
                  что бывает с записью, которая не складывается."
        }
        step 4.4 "Плитки стека, витрина сайтов и прочие сетки переведены на примитив"
        step 4.5 "Проверить на разных ширинах: дырявого ряда нет нигде"
    }

    stage 5 "Карусели на главной" state="ждёт" issue="#97" {
        note "Владелец: перевести на новую реализацию, без слипания карточек. Он это уже
              ловил - «мафия и дружина слиплись»."

        step 5.1 "Проверить, что на главной стоит и на чём собрано"
        step 5.2 "Перевести оставшееся на примитив карусели"
        step 5.3 "Отступ у первой и последней карточки равен зазору между ними"
    }

    stage 6 "Два плейлиста на одной странице" state="ждёт" issue="#98" {
        note "Выбор видео живёт в адресе одним значением на страницу: переключил в одном
              плейлисте - соседний своего кода не находит и сбрасывается на первое видео."
        note "Значение подписывается плейлистом: v=<плейлист>:<видео>, параметр повторяется.
              Без подписи - прежний вид, чтобы разосланные ссылки работали. Начато и отложено."

        step 6.1 "Подписанный выбор: чтение и запись"
        step 6.2 "Плеер и список берут своё значение"
        step 6.3 "Проверить на странице с двумя плейлистами"
    }

    stage 7 "Вход как второй путь к доступу" state="ждёт" issue="#99" {
        note "Право вошедшего уже ищется в базе, повторное погашение кода продлевает его.
              Осталось лицо: при отказе «нужен вход» зритель видит только ввод кода."

        step 7.1 "В заглушке отказа предлагается войти"
        step 7.2 "Проверить: вошёл на другом устройстве - доступ нашёлся сам"
    }

    stage 8 "Хвосты по сделанному" state="ждёт" {
        step 8.1 "Продолжение просмотра проверить на длинном видео" {
            note "Место не запоминается в последние двадцать секунд, а все демо-видео короче.
                  Правка общая с таймкодом, живого подтверждения нет."
        }
        step 8.2 "Убрать из хранилища прежние снимки сайтов" {
            note "При замене файлов Payload завёл новые имена, старые остались лежать."
        }
        step 8.3 "Проверить панель и переключатель на живом сайте после последней выкладки"
        step 8.4 "Внешний узел настроек как источник переключателей" {
            note "Сейчас источник один - таблица в базе, плюс перекрытие переменной окружения.
                  Внешний узел появится, когда сайтов станет несколько: меняется только
                  прослойка чтения."
        }
        step 8.5 "Несколько звуковых дорожек у видео"
        step 8.6 "Удаление автора уносит его область целиком"
    }

    stage 9 "Витрина шаблона" state="ждёт" issue="#32" {
        step 9.1 "Показать на витрине блоки, статью с видео внутри и формы"
        step 9.2 "Почта администратора витрины переезжает на свой домен" state="в конце"
    }

    stage 10 "Секреты на проде" state="ждёт" issue="#100" {
        step 11.1 "Перезавернуть секреты, оставшиеся открытыми" blocked="ждём слова владельца" {
            note "Инструмент готов и проверен на копии базы. Прогон на рабочем сайте трогает
                  живые ключи, поэтому идёт с его ведома."
        }
    }

    stage 11 "Просмотры онлайн" blocked="ждём решения владельца" issue="#101" {
        note "Развилка: где держать живые просмотры. Отметка приходит от каждого зрителя раз
              в минуту, живёт минуты и тут же устаревает."
        note "Предложение: память приложения сейчас, отдельное быстрое хранилище - когда
              появится второй сайт с платными курсами. Разбор - в эпике #95."

        step 11.1 "Идентификатор просмотра и отметки «играю» с позицией"
        step 11.2 "Учёт живых просмотров с истечением по времени"
        step 11.3 "Лимит одновременных просмотров на учётную запись - настройка владельца"
        step 11.4 "Поведение при превышении: отказать новому или вытеснить самый старый"
        step 11.5 "Сколько смотрит прямо сейчас - в админке"
        step 11.6 "Уборка протухших просмотров"
        step 11.7 "Отдельный текст при превышении лимита"
        step 11.8 "Проверка: третий зритель на двух разрешённых получает понятный отказ"
    }

    stage 12 "Статистика и реакции" blocked="ждём решения владельца" issue="#102" {
        note "Считается из тех же отметок, что и живые просмотры, поэтому решается вместе
              с этапом 9."

        step 12.1 "Счётчики: всего просмотров, уникальных, средняя глубина"
        step 12.2 "Досмотры: четверть, половина, три четверти, до конца"
        step 12.3 "Кривая удержания: на какой секунде бросают"
        step 12.4 "Лайки: один на зрителя, снимается повторным нажатием"
        step 12.5 "Защита от накрутки: лайк привязан к зрителю, а не к нажатию"
        step 12.6 "Просмотры и лайки рядом с плеером и на странице видео"
        step 12.7 "Сводка в админке: карточка видео и список по популярности"
        step 12.8 "Блок «Популярное»"
        step 12.9 "Статистика по плейлисту целиком"
        step 12.10 "Автор видит статистику только по своим плейлистам"
        step 12.11 "Проверка: счётчики и лайки не накручиваются перезагрузкой"
    }

    stage 13 "Доставка кодов" blocked="ждём решения владельца" issue="#103" {
        note "Оба пункта упираются в одно: чем доставлять код человеку, у которого его нет
              под рукой. Предложение: почта сейчас, сообщения на телефон - когда пойдут
              продажи. Почтовый отправитель шаблону нужен и без этого."

        step 13.1 "Подтверждение устройства без учётной записи"
        step 13.2 "Повторная выдача кода: почтой или сообщением"
    }
}

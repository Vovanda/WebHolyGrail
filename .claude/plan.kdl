// Работы по Web Holy Grail. План пересобран 29.08.2026: прежний разросся до 2730 строк
// и стал складом. Закрытое вырезано, дальнее живёт в issue и раскрывается, когда дойдём.
// История решений - в plan.kdl.before-cleanup и в комментариях к задачам.

plan "Работы по WHG" {

    note "Порядок: сначала то, на что указал владелец и что видно на сайте; потом
          внутреннее; потом то, что упирается в его решение."

    note "Пункт доводится до конца, и только потом берётся следующий. Уйти в соседний
          на половине нельзя ни при каком поводе: сначала правится план, потом меняется
          работа."

    note "Новое не дописывается в конец, а встраивается по важности: пункт ставится
          туда, где ему место в очереди, а этапы при этом переставляются. Дописывание
          в хвост и превратило прежний план в склад на две с половиной тысячи строк."

    note "Закрытое из плана убирается, а не копится. Ценное из него - техника, разбор,
          принятое решение - переезжает в задачу, к которой относится, и живёт там."

    note "Дальнее не расписывается шагами заранее: оно лежит задачей и раскрывается,
          когда до него дошли. Иначе план описывает выдуманную работу."

    note "Правка без своего смоука не закрыта. Смотрю браузером сам, до того как сказано
          «сделано»; непроверенное остаётся с пометкой «глазами не смотрено»."

    note "Перед проверкой глазами убедиться, что местный сайт смотрит в свою CMS,
          а не в CMS витрины: иначе смотришь не на свою правку. Ключ шифрования
          у местной копии свой, закрытые поля видео из витрины не расшифруются."

    stage 1 "Круг выкладки: шаблон, сайты, перенос" state="идёт" {
        note "За ночь 29.08 шаблон ушёл далеко вперёд прода: 45 коммитов лежат
              неотправленными, сайты стоят на версиях недельной давности. Пока не
              выложено, работа существует только на стенде."

        step 1.1 "Выложить шаблон" now=true {
            note "Отправить main, дождаться прогона, посмотреть прод глазами: сетка
                  на трёх ширинах, поля раскладки в админке, свой стиль блока."
            note "Отдельно проверить то, что владелец не подтверждал: ввод в полях
                  стиля - курсор и пробелы (#118)."
        }

        step 1.2 "fitness-mafia и sawking-tech" depends="1.1" {
            note "На каждый: снять копию базы, отметить догоняющую миграцию применённой,
                  слить ветку, выложить, посмотреть глазами."
            note "Отметка нужна потому, что у них убраны миграции-дубликаты, а на живой
                  базе те таблицы давно созданы - иначе прогон упадёт на «таблица уже
                  существует»."
        }

        step 1.3 "Синк трёх сайтов свежим шаблоном" depends="1.2" {
            note "Раскладка, нотация, разметка плиток и починка состава блока приезжают
                  к ним синком. После синка - проверка глазами на каждом."
            note "Заодно посмотреть список документов: он переведён на общий примитив,
                  но глазами не смотрен - на стенде таких данных нет."
        }

        step 1.4 "veo55 - перенос на новый шаблон" depends="1.3" issue="#69" {
            note "Самый тяжёлый: через синк не проходил ни разу, маркера нет."
            note "Владелец: переносится в пользу шаблона, но своего не теряет. Перед
                  прогоном - перечень доменного, у каждого пункта решение: остаётся
                  доменным, поднимается в шаблон обобщением или заменяется шаблонным
                  аналогом. Пункт без решения не переносится."
            note "Механика безопасности: отдельная ветка, прогон по частям - сперва
                  contracts и cms, отдельным шагом client, отдельным deploy; после каждой
                  части сборка."
        }
    }

    stage 2 "Хвосты сетки плиток" state="ждёт выкладки" issue="#88 #117" {
        note "Раскладка из админки работает и проверена числами на трёх ширинах.
              Осталось то, что не блокирует выкладку."

        step 2.1 "Негодная запись: админка называет, чего не хватает" issue="#117" {
            note "Пропущенные в начале буквы означают неразмещённые плитки - сейчас они
                  молча уезжают вниз."
        }

        step 2.2 "Тумблер: плитки растягиваются вместо центровки" issue="#117" {
            note "Другая арифметика - ряд делится на равные доли. Центрирование уже даёт
                  приличный вид, так что это добавка."
        }

        step 2.3 "Убрать флекс-расчёт ширины, когда сетка обкатана"

        step 2.4 "Предпросмотр блока: один блок в воздухе" issue="#119" {
            note "Кнопка у блока, серый фон, три кнопки ширины, крестик. Берём livePreview
                  у Payload, свой маршрут рисует один блок по номеру."
        }
    }

    stage 3 "Порядок в наборе компонентов" state="ждёт" issue="#120 #122 #123 #124" {
        note "Разобрано ночью 29.08: набор оброс копиями под задачу, границы взяты
              неверно. Правила и порядок действий записаны в навык whg-components."

        step 3.1 "Grid как примитив зонирования, плитки поверх" issue="#122"
        step 3.2 "Плитки: один компонент с видами карточки" issue="#123"
        step 3.3 "Плейлист: источник, карточка, представление врозь" issue="#124"
        step 3.4 "Композиция: представление и выбранный источник" issue="#120"
    }

    stage 4 "Поставка страниц-примеров" state="ждёт" issue="#116" {
        note "Примеры приезжают через API с отметкой о поставленном: удалённый не
              вернётся, правленый не затрётся, на живом сайте не появится."
    }

    note "Дальше по очереди - задачи, которые раскроются в шаги, когда дойдём:
          #98 два плейлиста на странице, #99 вход как второй путь к доступу,
          #32 витрина шаблона, #100 секреты на проде, #101 просмотры онлайн,
          #102 статистика и реакции, #103 доставка кодов, #91 синк и scripts,
          #92 importmap, #87 история адресов, #85 очистка своей разметки."
}

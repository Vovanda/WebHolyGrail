        }
        step 27.4 "Два плейлиста на странице не делят выбор видео" {
            note "Значение в адресе подписывается плейлистом: v=<плейлист>:<видео>, параметр
                  повторяется. Без подписи - прежний вид, чтобы разосланные ссылки работали."
            note "Сейчас значение общее: переключил видео в одном плейлисте - соседний своего
                  кода не находит и сбрасывается на первое видео."
        }
        step 27.5 "Проверить на живом сайте: демо, страница плейлиста, страница видео"
    }

    stage 29 "Таймкод в адресе не перематывает" state="ждёт" {
        note "Владелец поймал 27.08.2026: https://whg.sawking.tech/@whg/v/RsrNVjJ?t=5 открывает
              видео с начала, а должно с пятой секунды."
        note "Ссылка с таймкодом - обычное дело: ею делятся, чтобы показать нужное место,
              и ждут ровно этого поведения от любого сайта с видео."
        note "Смотреть заодно и соседнее: продолжение просмотра запоминает место само, и
              таймкод из адреса должен быть важнее запомненного - человек пришёл по ссылке
              именно за этой секундой."

        step 29.1 "Разобраться, читается ли t= вообще"
        step 29.2 "Перемотка к таймкоду при открытии"
        step 29.3 "Проверить на живом сайте: ссылка, перезагрузка, продолжение просмотра"
    }

    stage 28 "Снимки сайтов витрины в обеих темах" state="идёт" {
        note "Владелец просил и напомнил: зайти на каждый сайт витрины, включить тёмную тему -
              снимок, включить светлую - снимок, и показывать их по теме сайта."
        note "Проверил, что стояло: тёмный и светлый снимок каждого сайта - один и тот же файл
              под двумя именами, контрольные суммы совпадают. То есть тёмную тему я тогда не
              снимал вовсе, а подставил копию. Владелец был прав."
        note "Сайты витрины: veo55.ru, sawking.tech, sng74.ru, fitness-mafia.ru."

        step 28.1 "Обойти сайты браузером и снять обе темы" now=true
        step 28.2 "Залить и проставить в витрине"
        step 28.3 "Проверить переключением темы на демо"
    }

    stage 26 "След в задачах" state="закрыт" {
        note "Работа по видео шла по этому плану, а в задачах её видно не было. Владелец
              спросил про статусы - и оказалось, что закрытого в issues нет вовсе."
        note "Заведён эпик #95: что работает, что проверено на рабочем сайте, три развилки
              за владельцем и остаток в работе. План остаётся рабочим документом, эпик -
              витриной состояния."

        step 26.1 "Флаги: #94 закрыта с отчётом" done=true
        step 26.2 "Панели: #36 дополнена тем, что сделано, и тем, что осталось" done=true {
            note "Задача не закрыта: табов и изменения размера мышью нет, ось «что внутри»
                  ни одному живому случаю пока не понадобилась."
        }
        step 26.3 "Видео: заведён эпик #95 с состоянием и развилками" done=true
    }

    stage 25 "Тексты самих видео на живом сайте" state="закрыт" {
        note "Проверка страниц ловила выдуманные слова в разметке, а названия и описания
              самих видео лежат в базе и на те страницы не попадали: «Знакомство с набором»
              и «Этот ролик открыт» видны только на странице отдельного видео."
        note "Правится запросами под учёткой владельца, как весь остальной контент."

        step 25.1 "Названия и описания видео вычищены" done=true {
            note "Грабля на ровном месте: первая замена молча ничего не сделала. В JavaScript
                  граница слова считает буквами только латиницу, поэтому с кириллицей она не
                  срабатывает вовсе - пришлось писать границу самому через соседние буквы."
            note "Прошлись по документам целиком, а не по перечисленным полям: слова сидели и
                  в подписи медиафайла, и внутри блоков страницы."
            note "После замены проверено глазами: тексты читаются связно, согласование не
                  поехало, страницы отвечают."
        }
    }

    stage 24 "Слова, которыми называются вещи" state="закрыт" {
        note "Владелец поймал дважды подряд: «ролик» и «набор» - выдумка, в интернете
              повсеместно говорят «видео» и «плейлист». Туда же «запись» вместо видео.
              Расходятся не только тексты: в коде одно слово, в админке другое, в разговоре
              третье, и объяснить владельцу, где что, становится нечем."
        note "Правило шире видео и живёт в памяти: прежде чем ввести слово для сущности,
              берётся то, которым её называет владелец. Синонимы «поизящнее» - рассинхрон,
              а не улучшение."
        note "Соседнее правило оттуда же: тексты для людей пишутся мягко и связно, без
              рубленых фраз, двоеточий-рубрикаторов, оборотов «не X, а Y» и объяснений
              «потому что» в конце. Проверка - прочитать вслух."

        step 24.1 "План вычищен" done=true {
            note "Замена по падежам, иначе получается «два разных плейлист». Отдельно
                  проверено согласование: «видео» среднего рода и не склоняется, поэтому
                  «часовой видео» и «видео готова» пришлось править руками."
            note "Не тронуты «учётная запись», «запись экрана» и «запись в базу» - там слово
                  означает другое."
        }
        step 24.2 "Код, спецификация и подписи в админке вычищены" done=true {
            note "Правлены Плейлисты, блок видео, ход нарезки, Медиа, выдача доступа,
                  формальная спецификация и комментарии в развёртывании."
        }
        step 24.3 "Тексты на живом сайте проверены" done=true {
            note "Главная, демо видео, канал, плейлист, страница видео, FAQ и блог прочитаны
                  насквозь: выдуманных слов не осталось. Контент правился раньше через API,
                  выкладка ему не нужна."
        }
    }
}

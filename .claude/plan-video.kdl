            note "Деплой руками - только штатным скриптом со всеми переменными; порты                   узнаются у nginx. Записано в skill whg-deploy после падения сайта в 502."
        }
    }

    stage 21 "Как у платформ: то, что зритель уже умеет" state="закрыт" {
        note "Привычки зрителя сложились до нас: онлайн-кинотеатры и видеоплощадки               выработали набор приёмов, и спорить с ними нечем. Всё, чего нет из этого               списка, читается как недоделанный плеер, а не как наш выбор."
        note "Порядок продиктован частотой встречи: сначала то, без чего просмотр подряд               неудобен, потом нужное части зрителей, потом приятное."

        step 21.1 "Конец ролика: карточка следующего с превью" done=true {
            note "Кончился ролик - экран не должен становиться чёрным тупиком. Показываем                   следующий кадром и названием, нажатие открывает его в том же плеере                   без перезагрузки страницы."
            note "Автопереход с обратным отсчётом и отменой: без отмены он уводит с ролика,                   который человек хотел досмотреть до конца."
        }
        step 21.2 "Продолжить с места остановки" done=true {
            note "Позиция запоминается и предлагается при возврате: длинную запись редко                   смотрят за раз, а искать место вручную мучительно."
            note "Начало и конец не запоминаем: в начале возвращать некуда, а досмотренную                   запись человек открывает заново - вернуть его на титры хуже, чем ничего."
            note "Таймкод в адресе главнее памяти: открывший ссылку на конкретное место                   попадает именно туда."
            note "Место живёт в браузере зрителя: это его удобство, серверу оно не нужно."
        }
        step 21.3 "Субтитры: несколько языков, выбор в плеере" done=true {
            note "Нужны слабослышащим и тем, кто не владеет языком записи. Формат VTT,                   дорожки отдельными файлами - перенарезка не нужна."
            note "Выбор запоминается: включивший субтитры однажды ждёт их и дальше."
            note "Дорожки заводятся у записи в админке: язык, подпись и файл. Одну можно                   пометить включённой сразу - она достанется тем, кто ничего не выбирал."
            note "Дорожка без файла или без языка пропускается: показать её нечем."
        }
        step 21.4 "Клавиатура: пробел, стрелки, полный экран, звук" done=true {
            note "Раскладка общая у всех площадок, поэтому своей быть не может."
            note "Пришла вместе с Vidstack: пробел, стрелки, f, m работают из коробки."
        }
        step 21.5 "Ссылка с таймкодом: «смотри с 3:20»" done=true {
            note "Так пересылают куски записей: без этого человек шлёт ссылку и словами                   объясняет, куда мотать."
            note "Понимает оба привычных вида: `?t=200` и `?t=3m20s`, регистр не важен.                   Мусор пропускается молча - запись открывается с начала."
            note "Позиция ставится один раз, когда стала известна длительность: раньше                   перемотка теряется, позже - вырывала бы зрителя с места, где он смотрит."
            note "Рядом с записью кнопка «ссылка с этого места»: она и делает таймкод                   полезным."
        }
        step 21.6 "Главы: разметка по времени с подписями" done=true {
            note "Длинную запись смотрят кусками. Главы превращают полосу времени                   в оглавление и попадают в поисковую выдачу."
            note "Заводятся строками в админке: время начала и название. Дорожка для плеера                   собирается в браузере, файла на диске не появляется - владелец правит                   строки, а не разметку."
            note "Порядок ввода не важен: главы выстраиваются по времени сами. Последняя                   тянется до конца записи."
        }
        step 21.7 "Кадры-подсказки при перемотке" done=true {
            note "Полоса без кадров - перемотка вслепую. Кадры снимаются при нарезке                   одной лентой, чтобы не тянуть сотню картинок."
            note "Промежуток считается от длительности: у короткой записи кадры чаще,                   у часовой реже, и лента остаётся одного порядка по весу."
            note "Лента кладётся рядом с нарезкой, а не в медиатеку: редактору она не нужна,                   а в списке файлов была бы мусором. Заодно уходит в раздачу."
            note "Разметка к ленте собирается в браузере из описания сетки; сбой при съёмке                   кадров нарезку не роняет - полоса просто остаётся без подсказок."
        }
        step 21.8 "Мини-плеер при прокрутке страницы" done=true {
            note "Запись уезжает вверх и просмотр прерывается. Оставляем её уголком в правом                   нижнем углу, с кнопкой убрать."
            note "Только у играющей записи: поставленную на паузу отложили сознательно,                   догонять зрителя окошком незачем."
            note "Включается по месту: на странице записи под ней есть что читать, а в ленте                   одинаковых карточек от уголка одно мельтешение."
        }
        step 21.9 "Несколько звуковых дорожек" depends="21.3" {
            note "Тот же механизм, что у субтитров: озвучка на другом языке."
        }
    }

    stage 22 "Проверка" state="идёт" now=true {
        step 22.1 "Реальная запись: нарезка, перемотка, смена качества" done=true {
            note "Проверено на живом сайте: перемотка с двух секунд на двенадцатую работает,                   воспроизведение продолжается; в потоке две ступени - 480 и 720."
            note "По ходу нашлись английские подписи кнопок - «PiP», «Fullscreen», «AirPlay»:                   словарь их не покрывал, дополнен."
        }
        step 22.2 "Мобильный и медленный канал" done=true {
            note "На узком экране кадр вписывается, воспроизведение идёт, доступны звук,                   настройки, полный экран и трансляция."
            note "Первым грузится лёгкий вариант - 480p, и только потом плеер поднимается                   до 720p: на слабом канале первый кадр появляется быстро."
        }
        step 22.3 "Закрытое: без входа не играет, оригинал недоступен" done=true {
            note "Проверено на живом сайте: закрытой записи ключ не выдаётся («нужен вход»),                   открытой выдаётся, тот же запрос с чужого сайта отклоняется."
            note "Исходник после нарезки удалён - по соседнему адресу пусто. Куски потока                   отдаются, но их содержимое случайные байты: без ключа скачанное бесполезно."
        }
        step 22.4 "Переключение туда-обратно — мгновенное, без перенарезки" done=true {
            note "Проверено на живом сайте: закрыть и открыть заняло по две десятых секунды,                   адрес потока не изменился, состояние осталось «готово»."
        }
        step 22.5 "Чужой конверт не открывает поток" done=true {
            note "Проверено на живом сайте с настоящим шифрованием: свой конверт открывается                   и отдаёт секрет в шестнадцать байт, чужим ключом - отказ подлинности."
            note "У каждого зрителя свой ключ внутри токена, поэтому и конверты у них разные:                   переслать открытый конверт другому бессмысленно."
        }
        step 22.6 "Лимит просмотров: третий зритель на двух разрешённых получает понятный отказ" blocked="ждёт этапа про просмотры онлайн"
        step 22.7 "Счётчики и лайки не накручиваются перезагрузкой страницы" blocked="ждёт этапа про статистику"
    }
}

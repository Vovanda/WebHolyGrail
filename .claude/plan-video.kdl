        note "Делать в конце, вместе с остальной уборкой витрины: работа не блокирует               ничего, но старые снимки подрывают доверие ровно там, где его добывают."
        note "Описания под ссылками тоже устарели и написаны от руки. Брать их надо из               разметки самих сайтов - тега описания на главной: он и так поддерживается               владельцем ради поисковой выдачи, значит на витрине не разойдётся."
        step 19.1 "Снять свежие снимки главных страниц живых сайтов" done=true
        step 19.2 "Заменить через API, старые файлы удалить из медиатеки" done=true {
            note "Четыре снимка сняты браузером на широком экране, загружены и подставлены                   в карточки; прежние убраны из медиатеки, чтобы не лежали мусором."
        }
        step 19.3 "Описания брать из разметки сайтов, а не писать руками" done=true {
            note "Проверить заодно заголовки: у части ссылок подписью стоит сам адрес,                   и строка читается как «sawking.tech - sawking.tech»."
            note "Исправлено: подписью теперь стоит имя, которым сайт называет себя сам,                   а пояснение взято из его описания в разметке."
        }
    }

    stage 20 "Код доступа доводится до работающего вида" state="закрыт" {
        note "Проверено на живом сайте: код выдаётся и гасится, но ролики не открываются,               а окно ввода возвращается снова. Это цепочка из трёх поломок, и без неё               вся затея с доступом не работает - поэтому идёт раньше остального."

        step 20.1 "Право из токена доходит до проверки доступа" done=true {
            note "Политика спрашивалась до разбора токена и права из кода не видела:                   зритель вводил код и продолжал получать «нужен вход»."
        }
        step 20.2 "Токен переживает перезагрузку: живёт в куке" done=true {
            note "Право дописывается в токен, а токен жил в разметке страницы. При                   обновлении сервер выписывал новый пустой - замок возвращался."
        }
        step 20.3 "Адрес потока приходит и для закрытых роликов" done=true {
            note "Без ключа поток бесполезен - ровно поэтому сегменты лежат в общем кеше                   сети раздачи. Зато адрес известен заранее, и после кода ролик играет                   без обращения к серверу за списком."
        }
        step 20.4 "Замки снимаются на месте, с анимацией, без перезагрузки" done=true {
            note "Перезагрузка после кода - костыль: она сбрасывает позицию, моргает                   страницей и возвращает окно ввода, если признак остался в адресе."
            note "Набор слушает событие об открытии и снимает замки у себя; окно                   закрывается сразу и в адресе не остаётся."
        }
        step 20.5 "Код можно скопировать кнопкой, а не выделять руками" done=true
        step 20.6 "Окно закрывается после верного кода" done=true {
            note "Адрес сбрасывался дважды: первый сброс убирал признак молча, и второй                   блок уже не слал событий - окно висело поверх кадра, а замки снимались                   под затемнением, где анимации не видно."
        }
        step 20.7 "Проверить весь путь на живом сайте: код, ввод, воспроизведение" done=true {

// Видео в Web Holy Grail. План переписан 27.08.2026 с текущего прогресса: прежний
// разросся до тысячи строк и стал нечитаемым. Всё незакрытое перенесено сюда,
// история решений осталась в plan-video.kdl.old.

plan "Видео на сайте" {

    note "Порядок: сначала то, на что владелец указал и что видно на сайте; потом внутреннее;
          потом то, что упирается в его решение."

    stage 1 "Что уже работает" state="закрыт" {
        note "Сводка, чтобы не искать в истории. Подробности - в задачах #94, #36 и эпике #95."

        step 1.1 "Нарезка в несколько качеств, шифрование, удаление исходника" done=true
        step 1.2 "Доступ: открытое всем, закрытое по праву на плейлист" done=true
        step 1.3 "Коды доступа: выдача, ввод, снятие замков без перезагрузки" done=true
        step 1.4 "Плеер: субтитры, оглавление, кадры на полосе, мини-плеер, метка зрителя" done=true
        step 1.5 "Плейлист: колонкой, лентой или панелью за кнопкой над плеером" done=true
        step 1.6 "Выбранное видео и таймкод живут в адресе" done=true
        step 1.7 "Защита от выкачивания: счёт ключей и кусков, проверка источника" done=true
        step 1.8 "Переключатели возможностей, выбор слоя плеера на признаке" done=true
        step 1.9 "Витрина: снимки сайтов в двух темах" done=true
    }

    stage 2 "Плейлист виден там, где его ищут" state="идёт" {
        note "Владелец указал 27.08.2026 на три места подряд: в каждом либо пусто, либо строка
              текста там, где ждёшь карточку."

        step 2.1 "Кнопка плейлиста продублирована в шапке панели меню" now=true {
            note "Прямая просьба: та же кнопка, что стоит над плеером, справа от лого
                  с названием в шапке панели меню."
            note "Панель меню открывается на любой странице, поэтому кнопка появляется только
                  когда на странице есть плейлист в режиме панели."
        }
        step 2.2 "Обложка плейлиста стопкой кадров" done=true {
            note "Канал отдаёт до трёх кадров видео, клиент кладёт их стопкой со сдвигом.
                  Своя обложка, если задана, показывается как есть."
        }
        step 2.3 "На канале плейлист показывается карточкой с обложкой" depends="2.2" {
            note "Код выложен, осталось посмотреть глазами на живом сайте."
        }
        step 2.4 "На странице видео плейлисты показываются карточками, а не строкой" {
            note "Сейчас там строка «входит в плейлисты»."
        }
    }

    stage 3 "Карусели на главной" state="ждёт" {
        note "Владелец: перевести на новую реализацию, без слипания карточек. Он это уже
              ловил - «мафия и дружина слиплись»."

        step 3.1 "Проверить, что на главной стоит и на чём собрано"
        step 3.2 "Перевести оставшееся на примитив карусели"
        step 3.3 "Отступ у первой и последней карточки равен зазору между ними"
    }

    stage 4 "Два плейлиста на одной странице" state="ждёт" {
        note "Выбор видео живёт в адресе одним значением на страницу: переключил в одном
              плейлисте - соседний своего кода не находит и сбрасывается на первое видео."
        note "Значение подписывается плейлистом: v=<плейлист>:<видео>, параметр повторяется.
              Без подписи - прежний вид, чтобы разосланные ссылки работали. Начато и отложено."

        step 4.1 "Подписанный выбор: чтение и запись"
        step 4.2 "Плеер и список берут своё значение"
        step 4.3 "Проверить на странице с двумя плейлистами"
    }

    stage 5 "Вход как второй путь к доступу" state="ждёт" {
        note "Право вошедшего уже ищется в базе, повторное погашение кода продлевает его.
              Осталось лицо: при отказе «нужен вход» зритель видит только ввод кода."

        step 5.1 "В заглушке отказа предлагается войти"
        step 5.2 "Проверить: вошёл на другом устройстве - доступ нашёлся сам"
    }

    stage 6 "Хвосты по сделанному" state="ждёт" {
        step 6.1 "Продолжение просмотра проверить на длинном видео" {
            note "Место не запоминается в последние двадцать секунд, а все демо-видео короче.
                  Правка общая с таймкодом, живого подтверждения нет."
        }
        step 6.2 "Убрать из хранилища прежние снимки сайтов" {
            note "При замене файлов Payload завёл новые имена, старые остались лежать."
        }
        step 6.3 "Проверить панель и переключатель на живом сайте после последней выкладки"
        step 6.4 "Внешний узел настроек как источник переключателей" {
            note "Сейчас источник один - таблица в базе, плюс перекрытие переменной окружения.
                  Внешний узел появится, когда сайтов станет несколько: меняется только
                  прослойка чтения."
        }
        step 6.5 "Несколько звуковых дорожек у видео"
        step 6.6 "Удаление автора уносит его область целиком"
    }

    stage 7 "Витрина шаблона" state="ждёт" {
        step 7.1 "Показать на витрине блоки, статью с видео внутри и формы"
        step 7.2 "Почта администратора витрины переезжает на свой домен" state="в конце"
    }

    stage 8 "Секреты на проде" state="ждёт" {
        step 8.1 "Перезавернуть секреты, оставшиеся открытыми" blocked="ждём слова владельца" {
            note "Инструмент готов и проверен на копии базы. Прогон на рабочем сайте трогает
                  живые ключи, поэтому идёт с его ведома."
        }
    }

    stage 9 "Просмотры онлайн" blocked="ждём решения владельца" {
        note "Развилка: где держать живые просмотры. Отметка приходит от каждого зрителя раз
              в минуту, живёт минуты и тут же устаревает."
        note "Предложение: память приложения сейчас, отдельное быстрое хранилище - когда
              появится второй сайт с платными курсами. Разбор - в эпике #95."

        step 9.1 "Идентификатор просмотра и отметки «играю» с позицией"
        step 9.2 "Учёт живых просмотров с истечением по времени"
        step 9.3 "Лимит одновременных просмотров на учётную запись - настройка владельца"
        step 9.4 "Поведение при превышении: отказать новому или вытеснить самый старый"
        step 9.5 "Сколько смотрит прямо сейчас - в админке"
        step 9.6 "Уборка протухших просмотров"
        step 9.7 "Отдельный текст при превышении лимита"
        step 9.8 "Проверка: третий зритель на двух разрешённых получает понятный отказ"
    }

    stage 10 "Статистика и реакции" blocked="ждём решения владельца" {
        note "Считается из тех же отметок, что и живые просмотры, поэтому решается вместе
              с этапом 9."

        step 10.1 "Счётчики: всего просмотров, уникальных, средняя глубина"
        step 10.2 "Досмотры: четверть, половина, три четверти, до конца"
        step 10.3 "Кривая удержания: на какой секунде бросают"
        step 10.4 "Лайки: один на зрителя, снимается повторным нажатием"
        step 10.5 "Защита от накрутки: лайк привязан к зрителю, а не к нажатию"
        step 10.6 "Просмотры и лайки рядом с плеером и на странице видео"
        step 10.7 "Сводка в админке: карточка видео и список по популярности"
        step 10.8 "Блок «Популярное»"
        step 10.9 "Статистика по плейлисту целиком"
        step 10.10 "Автор видит статистику только по своим плейлистам"
        step 10.11 "Проверка: счётчики и лайки не накручиваются перезагрузкой"
    }

    stage 11 "Доставка кодов" blocked="ждём решения владельца" {
        note "Оба пункта упираются в одно: чем доставлять код человеку, у которого его нет
              под рукой. Предложение: почта сейчас, сообщения на телефон - когда пойдут
              продажи. Почтовый отправитель шаблону нужен и без этого."

        step 11.1 "Подтверждение устройства без учётной записи"
        step 11.2 "Повторная выдача кода: почтой или сообщением"
    }
}

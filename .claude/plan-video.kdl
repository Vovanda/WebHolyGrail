        note "Делать в конце, вместе с остальной уборкой витрины: работа не блокирует               ничего, но старые снимки подрывают доверие ровно там, где его добывают."
        note "Описания под ссылками тоже устарели и написаны от руки. Брать их надо из               разметки самих сайтов - тега описания на главной: он и так поддерживается               владельцем ради поисковой выдачи, значит на витрине не разойдётся."
        step 19.1 "Снять свежие снимки главных страниц живых сайтов" done=true
        step 19.2 "Заменить через API, старые файлы удалить из медиатеки" done=true {
            note "Снимков теперь по два на сайт - для светлой и тёмной темы: светлый снимок                   в тёмной теме выбивается ярким пятном. Карточка хранит оба, показывается                   подходящий."
            note "Медиатека вычищена: 56 снимков от прошлых прогонов удалены, осталось 19                   файлов вместо 67. Сайт после чистки проверен - страницы отвечают."
            note "Тексты берутся у сайтов дословно, а не пересказываются: описание из разметки,                   а где его нет - со страницы «о нас». Свои формулировки расходятся с тем,                   что владелец сайта написал о себе сам."
        }
        step 19.3 "Описания брать из разметки сайтов, а не писать руками" done=true {
            note "Проверить заодно заголовки: у части ссылок подписью стоит сам адрес,                   и строка читается как «sawking.tech - sawking.tech»."
            note "Исправлено: подписью стоит имя, которым сайт называет себя сам, пояснение -                   его собственное описание."
            note "Отступ по краям ленты приравнен к зазору между карточками: первая и последняя                   прилипали к рамке."
        }
    }

    stage 20 "Код доступа доводится до работающего вида" state="закрыт" {
        note "Проверено на живом сайте: код выдаётся и гасится, но видео не открываются,               а окно ввода возвращается снова. Это цепочка из трёх поломок, и без неё               вся затея с доступом не работает - поэтому идёт раньше остального."

        step 20.1 "Право из токена доходит до проверки доступа" done=true {
            note "Политика спрашивалась до разбора токена и права из кода не видела:                   зритель вводил код и продолжал получать «нужен вход»."
        }
        step 20.2 "Токен переживает перезагрузку: живёт в куке" done=true {

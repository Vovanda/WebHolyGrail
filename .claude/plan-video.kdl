        }
        step 20.7 "Проверить весь путь на живом сайте: код, ввод, воспроизведение" done=true {
            note "Пройдено целиком на живом сайте, на узком экране: код выдан, окно закрылось                   после ввода, оба замка сняты, ранее закрытое видео играет с расшифровкой."
        }
        step 20.8 "Низ плеера выглядит как у знакомых плееров" done=true {
            note "Полоса времени встала к нижнему краю, строка управления над ней; спрятанный                   оверлей больше не перехватывает касания - палец попадал в невидимую паузу."
        }
        step 20.9 "Заброшено: свой слой управления с нуля" state="отменено" {

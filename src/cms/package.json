{
  "name": "cms",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Payload CMS for Holy Grail site",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "node scripts/ensure-importmap.mjs && cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "node scripts/ensure-importmap.mjs",
    "seed:minimal": "cross-env NODE_OPTIONS=--no-deprecation tsx src/seed/minimal/index.ts",
    "seed:whg-landing": "cross-env NODE_OPTIONS=--no-deprecation tsx src/seed/whg-landing/index.ts",
    "check:schema": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/check-schema-drift.ts",
    "rewrap:secrets": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/rewrap-video-secrets.ts",
    "backup:db": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/backup-db.ts",
    "open:backup": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/open-backup.ts",
    "encrypt:db": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/encrypt-db.ts",
    "prepare:db": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/prepare-db.ts",
    "migrate": "pnpm prepare:db && cross-env NODE_OPTIONS=--no-deprecation payload migrate",
    "migrate:anchor": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/make-anchor.ts",
    "migrate:create": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:create",
    "migrate:status": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:status",
    "migrate:down": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:down",
    "migrate:refresh": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:refresh",
    "migrate:fresh": "cross-env NODE_OPTIONS=--no-deprecation payload migrate:fresh",
    "backfill:preview-url": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/backfill-preview-url.ts",
    "backfill:channel": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/backfill-channel.ts",
    "mark:derived-previews": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/mark-derived-previews.ts",
    "backfill:pack-bytes": "cross-env NODE_OPTIONS=--no-deprecation tsx scripts/backfill-pack-bytes.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1072.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@payloadcms/db-sqlite": "^3.40.0",
    "@payloadcms/next": "^3.40.0",
    "@payloadcms/richtext-lexical": "^3.40.0",
    "@payloadcms/storage-s3": "^3.85.1",
    "@payloadcms/translations": "^3.40.0",
    "@payloadcms/ui": "^3.40.0",
    "@uiw/react-codemirror": "^4.25.10",
    "contracts": "workspace:*",
    "cross-env": "^7.0.3",
    "iconv-lite": "^0.7.2",
    "libsql": "^0.4.7",
    "next": "^15.0.3",
    "payload": "^3.40.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.2",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.7",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
